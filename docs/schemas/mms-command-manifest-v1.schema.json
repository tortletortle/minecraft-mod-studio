{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MMS Mod Command Manifest",
  "description": "Untrusted descriptive metadata for command roots registered by one Fabric mod. This schema does not grant execution permission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "modId",
    "modVersion",
    "minecraftVersions",
    "commands"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "modId": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,64}$"
    },
    "modVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "minecraftVersions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(\\*|[0-9][A-Za-z0-9._+-]{0,31})$"
      }
    },
    "commands": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/command"
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "descriptions",
        "keywords",
        "effects",
        "executionContext",
        "advisoryRisk",
        "advisoryReversibility"
      ],
      "properties": {
        "root": {
          "type": "string",
          "pattern": "^[a-z0-9_.:-]{1,64}$"
        },
        "descriptions": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 8,
          "propertyNames": {
            "pattern": "^[a-z]{2}_[a-z]{2}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "keywords": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "examples": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "argumentDescriptions": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "minLength": 1,
            "maxLength": 96
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "blocks",
              "entities",
              "inventory",
              "world_rules",
              "time_weather",
              "player_state",
              "server_state",
              "structures",
              "unknown"
            ]
          }
        },
        "executionContext": {
          "enum": ["server", "player", "entity"]
        },
        "advisoryRisk": {
          "enum": ["read_only", "bounded_mutation", "destructive", "unknown"]
        },
        "advisoryReversibility": {
          "enum": ["reversible", "partially_reversible", "irreversible", "unknown"]
        }
      }
    }
  }
}
