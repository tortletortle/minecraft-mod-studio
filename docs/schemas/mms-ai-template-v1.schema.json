{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minecraft-mod-studio.invalid/schemas/mms-ai-template-v1.schema.json",
  "title": "Minecraft Mod Studio AI Template Library v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "libraryId",
    "libraryName",
    "product",
    "defaultPolicy",
    "templates"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "libraryId": {
      "const": "mms.ai-template-library"
    },
    "libraryName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minecraftEdition",
        "minecraftVersion",
        "modLoader"
      ],
      "properties": {
        "minecraftEdition": {
          "const": "Java"
        },
        "minecraftVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "modLoader": {
          "const": "Fabric"
        }
      }
    },
    "defaultPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultMode",
        "unknownCapability",
        "unknownCommand",
        "genericCommandExecution",
        "modManifestTrust",
        "mutationRequiresExplicitApproval",
        "mutationRequiresPreview",
        "mutationRequiresPostActionReadback",
        "stopOnStateDivergence",
        "claimRollbackOnlyWhenInverseExists",
        "separateObservedFactsFromInferences"
      ],
      "properties": {
        "defaultMode": {
          "enum": [
            "read_only",
            "plan_only"
          ]
        },
        "unknownCapability": {
          "const": "deny"
        },
        "unknownCommand": {
          "const": "deny"
        },
        "genericCommandExecution": {
          "const": "disabled"
        },
        "modManifestTrust": {
          "const": "untrusted_descriptive_data_only"
        },
        "mutationRequiresExplicitApproval": {
          "const": true
        },
        "mutationRequiresPreview": {
          "const": true
        },
        "mutationRequiresPostActionReadback": {
          "const": true
        },
        "stopOnStateDivergence": {
          "const": true
        },
        "claimRollbackOnlyWhenInverseExists": {
          "const": true
        },
        "separateObservedFactsFromInferences": {
          "const": true
        }
      }
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "name",
          "category",
          "description",
          "triggerExamples",
          "mode",
          "inputVariables",
          "requiredCapabilities",
          "optionalCapabilities",
          "workflow",
          "promptTemplate",
          "resultContract",
          "guardrails"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,47}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\\\.[0-9]+\\\\.[0-9]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "triggerExamples": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 120
            }
          },
          "mode": {
            "enum": [
              "read_only",
              "plan_only",
              "approval_gated"
            ]
          },
          "inputVariables": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "type",
                "required",
                "description"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{1,47}$"
                },
                "type": {
                  "enum": [
                    "string",
                    "boolean",
                    "integer"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "default": {},
                "enum": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "type": [
                      "string",
                      "integer",
                      "boolean"
                    ]
                  }
                },
                "minimum": {
                  "type": "integer"
                },
                "maximum": {
                  "type": "integer"
                }
              }
            }
          },
          "requiredCapabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{2,79}$"
            }
          },
          "optionalCapabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{2,79}$"
            }
          },
          "workflow": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "operationClass",
                "approval",
                "instruction"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{1,47}$"
                },
                "operationClass": {
                  "enum": [
                    "read",
                    "analysis",
                    "plan",
                    "mutation"
                  ]
                },
                "approval": {
                  "enum": [
                    "not_required",
                    "explicit_user_approval"
                  ]
                },
                "instruction": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                }
              }
            }
          },
          "promptTemplate": {
            "type": "string",
            "minLength": 40,
            "maxLength": 5000
          },
          "resultContract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requiredSections"
            ],
            "properties": {
              "requiredSections": {
                "type": "array",
                "minItems": 1,
                "maxItems": 24,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{1,47}$"
                }
              },
              "requireEvidenceForClaims": {
                "type": "boolean"
              },
              "requireExecutionStatusLiteral": {
                "type": "string"
              },
              "requirePatchPreview": {
                "type": "boolean"
              },
              "requireAppliedChangeLiteral": {
                "type": "string"
              },
              "requireWorldMutationLiteral": {
                "type": "string"
              },
              "requireSameTargetUuidForAllSteps": {
                "type": "boolean"
              },
              "requireReadbackAfterMutation": {
                "type": "boolean"
              },
              "requireCounterEvidence": {
                "type": "boolean"
              },
              "requireDependencyGraph": {
                "type": "boolean"
              },
              "requirePerStepAcceptanceCriteria": {
                "type": "boolean"
              }
            }
          },
          "guardrails": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        }
      }
    }
  }
}
